# Copy to Backend/.env and replace the placeholder with the local database password.
# URL-encode reserved characters in the password. Never commit Backend/.env.
DATABASE_URL=postgresql+psycopg://uni_vibe_app:<local-password>@127.0.0.1:5432/uni_vibe_dev
APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
UPLOADS_DIR=uploads
